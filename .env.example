# Copiá este archivo como .env.local y completá los valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore).

# Supabase → Project Settings → API Keys / Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave pública ("publishable", empieza con sb_publishable_). Puede verse en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave SECRETA ("secret", empieza con sb_secret_). Solo servidor. Nunca la compartas.
SUPABASE_SECRET_KEY=

# Mercado Pago → developers.mercadopago.com → Tus integraciones → tu aplicación → Credenciales
# Access Token (de prueba o de producción). SECRETO, solo servidor.
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de los webhooks (Webhooks → Configurar notificaciones). Vacía en la PC de desarrollo.
MERCADOPAGO_WEBHOOK_SECRET=
# Dirección pública de la tienda (en Vercel, https://…). Mercado Pago solo vuelve a la tienda
# y manda avisos de pago si es https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
